@page "/profile"
@layout AuthenticatedLayout
@using Microsoft.AspNetCore.Authorization
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Profile
@using Xqare.BusinessLayer.Validators
@using Xqare.BusinessLayer.Validators.FluentValidation
@attribute [Authorize]
@inject IProfileService ProfileService
@inject ISnackbar Snackbar

<PageTitle>Profile | XQARE</PageTitle>

<section class="profile-page" aria-labelledby="profile-page-title">
    <MudContainer MaxWidth="MaxWidth.False" Class="profile-container">
        <div class="profile-heading">
            <div class="profile-heading-copy">
                <MudText Typo="Typo.overline" Class="profile-eyebrow">ACCOUNT</MudText>
                <MudText Typo="Typo.h4" Class="profile-page-title" id="profile-page-title">Profile</MudText>
                <MudText Typo="Typo.body2" Class="profile-page-subtitle">
                    Manage your personal information and keep your account details up to date.
                </MudText>
            </div>

            @if (_profile is { IsSuccess: true })
            {
                <MudChip T="string" Variant="Variant.Outlined"
                         Color="@(_profile.IsActive ? Color.Success : Color.Warning)"
                         Class="profile-status-chip">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-2" />
                    @(_profile.IsActive ? "Account active" : "Account inactive")
                </MudChip>
            }
        </div>

        @if (_loading)
        {
            <MudPaper Class="profile-state-card" Elevation="0">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Class="profile-state-title">Loading your profile</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Your account information will appear here in a moment.</MudText>
            </MudPaper>
        }
        else if (_profile is null || !_profile.IsSuccess)
        {
            <MudPaper Class="profile-state-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Class="profile-state-icon" />
                <MudText Typo="Typo.h6" Class="profile-state-title">We couldn't load your profile</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(_profile?.Message ?? "Check your connection and try again.")
                </MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadProfileAsync" Class="profile-primary-button">
                    Try again
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="4" Class="profile-cards-grid">
                <MudItem xs="12" lg="8">
                    <MudPaper Class="profile-card profile-main-card" Elevation="0">
                        <div class="profile-card-heading">
                            <div class="profile-card-heading-left">
                                <span class="profile-card-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" />
                                </span>
                                <div class="profile-card-heading-copy">
                                    <MudText Typo="Typo.h6" Class="profile-card-title">Personal information</MudText>
                                    <MudText Typo="Typo.caption" Class="profile-card-subtitle">
                                        Your name and contact details
                                    </MudText>
                                </div>
                            </div>

                            @if (!_editing)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           Class="profile-edit-button" OnClick="BeginEdit">
                                    Edit profile
                                </MudButton>
                            }
                        </div>

                        <div class="profile-identity-panel">
                            <MudAvatar Image="@_profile.ProfileImageUrl" Class="profile-avatar"
                                       Color="Color.Primary" Size="Size.Large">
                                @Initials
                            </MudAvatar>
                            <div class="profile-identity-copy">
                                <MudText Typo="Typo.h6" Class="profile-person-name">@DisplayName</MudText>
                                <div class="profile-identity-email">
                                    <MudText Typo="Typo.body2" Class="profile-email-value">@_profile.Email</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(_profile.IsEmailConfirmed ? Color.Success : Color.Warning)"
                                             Variant="Variant.Outlined" Class="profile-email-chip">
                                        <MudIcon Icon="@(_profile.IsEmailConfirmed ? Icons.Material.Filled.Verified : Icons.Material.Filled.Info)"
                                                 Size="Size.Small" Class="mr-1" />
                                        @(_profile.IsEmailConfirmed ? "Verified" : "Not verified")
                                    </MudChip>
                                </div>
                            </div>
                        </div>

                        <MudDivider Class="profile-divider" />

                        @if (_editing)
                        {
                            <MudForm @ref="_form" Model="_edit"
                                     Validation="_editValidator.ToMudValidator()"
                                     Class="profile-edit-form">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="First name" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" FullWidth="true" Required="true"
                                                      RequiredError="First name is required." MaxLength="80"
                                                      For="@(() => _edit.FirstName)" @bind-Value="_edit.FirstName" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="Last name" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" FullWidth="true" Required="true"
                                                      RequiredError="Last name is required." MaxLength="80"
                                                      For="@(() => _edit.LastName)" @bind-Value="_edit.LastName" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Phone number" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" FullWidth="true" MaxLength="10"
                                                      InputType="InputType.Telephone" InputMode="InputMode.numeric"
                                                      Pattern="[0-9]*" Immediate="true"
                                                      Adornment="Adornment.Start" AdornmentText="+91"
                                                      AdornmentColor="Color.Secondary"
                                                      For="@(() => _edit.PhoneNumber)"
                                                      Value="_edit.PhoneNumber" ValueChanged="HandlePhoneNumberChanged"
                                                      HelperText="Enter your 10-digit Indian mobile number only." />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="About you" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" FullWidth="true" Lines="3"
                                                      MaxLength="600" Counter="600"
                                                      For="@(() => _edit.Bio)" @bind-Value="_edit.Bio"
                                                      Placeholder="Add a short introduction about yourself." />
                                    </MudItem>
                                </MudGrid>

                                <div class="profile-form-actions">
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                               Disabled="_saving" OnClick="CancelEdit">
                                        Cancel
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="_saving" OnClick="SaveProfileAsync"
                                               Class="profile-primary-button">
                                        @if (_saving)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                                            <span>Saving</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                                            <span>Save changes</span>
                                        }
                                    </MudButton>
                                </div>
                            </MudForm>
                        }
                        else
                        {
                            <div class="profile-details-grid">
                                <div class="profile-detail">
                                    <MudText Typo="Typo.overline" Class="profile-field-label">FIRST NAME</MudText>
                                    <MudText Typo="Typo.body1" Class="profile-field-value">
                                        @ValueOrFallback(_profile.FirstName)
                                    </MudText>
                                </div>
                                <div class="profile-detail">
                                    <MudText Typo="Typo.overline" Class="profile-field-label">LAST NAME</MudText>
                                    <MudText Typo="Typo.body1" Class="profile-field-value">
                                        @ValueOrFallback(_profile.LastName)
                                    </MudText>
                                </div>
                                <div class="profile-detail">
                                    <MudText Typo="Typo.overline" Class="profile-field-label">PHONE NUMBER</MudText>
                                    <MudText Typo="Typo.body1" Class="profile-field-value">
                                        @FormatPhoneNumber(_profile.PhoneNumber)
                                    </MudText>
                                </div>
                                <div class="profile-detail profile-detail-bio">
                                    <MudText Typo="Typo.overline" Class="profile-field-label">ABOUT</MudText>
                                    <MudText Typo="Typo.body1" Class="profile-field-value profile-bio-value">
                                        @ValueOrFallback(_profile.Bio, "Add a short introduction about yourself.")
                                    </MudText>
                                </div>
                            </div>
                        }

                        <div class="profile-account-meta">
                            <div class="profile-member-since">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                <MudText Typo="Typo.caption">
                                    Member since @_profile.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </MudText>
                            </div>

                            @if (_profile.Roles is { Count: > 0 })
                            {
                                <div class="profile-role-list" aria-label="Account roles">
                                    @foreach (var role in _profile.Roles)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="Color.Secondary">@role</MudChip>
                                    }
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <MudPaper Class="profile-card notification-card" Elevation="0">
                        <div class="profile-card-heading">
                            <div class="profile-card-heading-left">
                                <span class="profile-card-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" />
                                </span>
                                <div class="profile-card-heading-copy">
                                    <MudText Typo="Typo.h6" Class="profile-card-title">Notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="profile-card-subtitle">
                                        Updates you may be able to manage here
                                    </MudText>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                     Variant="Variant.Outlined" Class="profile-coming-soon">
                                Coming soon
                            </MudChip>
                        </div>

                        <MudDivider Class="profile-divider" />

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined"
                                  Dense="true" Icon="@Icons.Material.Outlined.Info"
                                  Class="notification-note">
                            Notification preferences are not active yet. No settings can be changed from this section today.
                        </MudAlert>

                        <div class="notification-preview-list">
                            <div class="notification-preview-row">
                                <span class="notification-preview-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.MailOutline" />
                                </span>
                                <div class="notification-preview-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Email updates</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">
                                        Important account and platform news
                                    </MudText>
                                </div>
                            </div>
                            <div class="notification-preview-row">
                                <span class="notification-preview-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" />
                                </span>
                                <div class="notification-preview-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Browser notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">
                                        Relevant activity and account alerts
                                    </MudText>
                                </div>
                            </div>
                            <div class="notification-preview-row">
                                <span class="notification-preview-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />
                                </span>
                                <div class="notification-preview-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Mentor reminders</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">
                                        Reminders before mentoring sessions
                                    </MudText>
                                </div>
                            </div>
                            <div class="notification-preview-row">
                                <span class="notification-preview-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarViewWeek" />
                                </span>
                                <div class="notification-preview-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Weekly digest</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">
                                        A summary of your weekly activity
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
</section>

@code {
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private MyProfileResponse? _profile;
    private UpdateMyProfileRequest _edit = new();
    private readonly UpdateMyProfileRequestValidator _editValidator = new();
    private MudForm? _form;

    private string DisplayName
    {
        get
        {
            if (_profile is null) return "XQARE member";

            var name = string.Join(" ", new[] { _profile.FirstName, _profile.LastName }
                .Where(value => !string.IsNullOrWhiteSpace(value)));

            return string.IsNullOrWhiteSpace(name)
                ? (_profile.DisplayName ?? "XQARE member")
                : name;
        }
    }

    private string Initials
    {
        get
        {
            var names = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (names.Length > 1)
                return string.Concat(names[0][0], names[^1][0]).ToUpperInvariant();

            return names.Length == 1 ? names[0][..1].ToUpperInvariant() : "X";
        }
    }

    protected override Task OnInitializedAsync() => LoadProfileAsync();

    private async Task LoadProfileAsync()
    {
        _loading = true;

        try
        {
            _profile = await ProfileService.GetMyProfileAsync();
            if (_profile.IsSuccess)
                CopyProfileToEdit();
            else
                Snackbar.Add(_profile.Message, Severity.Error);
        }
        catch
        {
            _profile = null;
            Snackbar.Add("Your profile could not be loaded. Please retry.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void CopyProfileToEdit()
    {
        if (_profile is null) return;

        _edit = new UpdateMyProfileRequest
        {
            FirstName = _profile.FirstName,
            LastName = _profile.LastName,
            PhoneNumber = ToIndianPhoneDigits(_profile.PhoneNumber),
            Bio = _profile.Bio
        };
    }

    private void BeginEdit()
    {
        if (_saving) return;

        CopyProfileToEdit();
        _editing = true;
    }

    private void CancelEdit()
    {
        if (_saving) return;

        CopyProfileToEdit();
        _editing = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_saving || !_editing) return;

        _saving = true;

        try
        {
            if (_form is not null)
            {
                await _form.ValidateAsync();
                if (!_form.IsValid) return;
            }

            // Normalize values before sending so the API receives the same trimmed values
            // that the UI validator accepts.
            _edit.FirstName = _edit.FirstName.Trim();
            _edit.LastName = _edit.LastName.Trim();
            _edit.PhoneNumber = string.IsNullOrWhiteSpace(_edit.PhoneNumber)
                ? null
                : _edit.PhoneNumber.Trim();
            _edit.Bio = string.IsNullOrWhiteSpace(_edit.Bio)
                ? null
                : _edit.Bio.Trim();

            var request = new UpdateMyProfileRequest
            {
                FirstName = _edit.FirstName,
                LastName = _edit.LastName,
                PhoneNumber = string.IsNullOrWhiteSpace(_edit.PhoneNumber)
                    ? null
                    : $"+91{_edit.PhoneNumber}",
                Bio = _edit.Bio
            };

            var response = await ProfileService.UpdateMyProfileAsync(request);
            if (!response.IsSuccess)
            {
                Snackbar.Add(response.Message, Severity.Error);
                return;
            }

            _profile = response;
            CopyProfileToEdit();
            _editing = false;
            Snackbar.Add(response.Message, Severity.Success);
        }
        catch
        {
            Snackbar.Add("Your profile could not be saved. Please try again.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task HandlePhoneNumberChanged(string? value)
    {
        var digits = new string((value ?? string.Empty).Where(char.IsAsciiDigit).ToArray());

        if (digits.Length == 13 && digits.StartsWith("910", StringComparison.Ordinal))
            digits = digits[3..];
        else if (digits.Length == 12 && digits.StartsWith("91", StringComparison.Ordinal))
            digits = digits[2..];
        else if (digits.Length == 11 && digits.StartsWith("0", StringComparison.Ordinal))
            digits = digits[1..];

        _edit.PhoneNumber = digits.Length > 10 ? digits[..10] : digits;
        return Task.CompletedTask;
    }

    private static string ToIndianPhoneDigits(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var digits = new string(value.Where(char.IsAsciiDigit).ToArray());

        if (digits.Length == 13 && digits.StartsWith("910", StringComparison.Ordinal))
            digits = digits[3..];
        else if (digits.Length == 12 && digits.StartsWith("91", StringComparison.Ordinal))
            digits = digits[2..];
        else if (digits.Length == 11 && digits.StartsWith("0", StringComparison.Ordinal))
            digits = digits[1..];

        return digits.Length > 10 ? digits[..10] : digits;
    }

    private static string FormatPhoneNumber(string? value)
    {
        var digits = ToIndianPhoneDigits(value);
        return digits.Length == 10
            ? $"+91 {digits[..5]} {digits[5..]}"
            : ValueOrFallback(value);
    }

    private static string ValueOrFallback(string? value, string fallback = "Not added yet")
        => string.IsNullOrWhiteSpace(value) ? fallback : value;
}
