@page "/profile"
@layout AuthenticatedLayout
@using Microsoft.AspNetCore.Authorization
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Profile
@using Xqare.BusinessLayer.Validators
@using Xqare.BusinessLayer.Validators.FluentValidation
@attribute [Authorize]
@inject IProfileService ProfileService
@inject ISnackbar Snackbar

<PageTitle>My Profile | XQARE</PageTitle>
<section class="profile-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="profile-container">
        <div class="profile-heading">
            <div>
                <MudText Typo="Typo.h4" Class="profile-page-title">My profile</MudText>
                <MudText Typo="Typo.body2" Class="profile-page-subtitle">Manage your personal information and notification preferences.</MudText>
            </div>
            @if (_profile != null && _profile.IsSuccess)
            {
                <MudChip T="string" Variant="Variant.Outlined"
                         Color="@(_profile.IsActive ? Color.Success : Color.Warning)" Class="profile-status-chip">
                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-1" />
                    @(_profile.IsActive ? "Account active" : "Account inactive")
                </MudChip>
            }
        </div>

        @if (_loading)
        {
            <MudPaper Class="profile-state-card" Elevation="0">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Loading your profile…</MudText>
            </MudPaper>
        }
        else if (_profile == null || !_profile.IsSuccess)
        {
            <MudPaper Class="profile-state-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Class="profile-state-icon" />
                <MudText Typo="Typo.h6">We couldn't load your profile</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(_profile?.Message ?? "Check your connection and try again.")</MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadProfileAsync" Class="profile-primary-button">Try again</MudButton>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="2" Class="profile-cards-grid">
                <MudItem xs="12" md="6">
                    <MudPaper Class="profile-card" Elevation="0">
                        <div class="profile-card-heading">
                            <div class="profile-card-heading-left">
                                <span class="profile-card-icon"><MudIcon Icon="@Icons.Material.Filled.PersonOutline" /></span>
                                <div>
                                    <MudText Typo="Typo.h6" Class="profile-card-title">Profile Information</MudText>
                                    <MudText Typo="Typo.caption" Class="profile-card-subtitle">Your personal details on XQARE</MudText>
                                </div>
                            </div>
                            @if (!_editing)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                                           Class="profile-edit-button" OnClick="BeginEdit">Edit</MudButton>
                            }
                        </div>

                        <div class="profile-person-summary">
                            <MudAvatar Image="@_profile.ProfileImageUrl" Class="profile-avatar" Color="Color.Warning" Size="Size.Large">
                                @Initials
                            </MudAvatar>
                            <div class="profile-person-copy">
                                <MudText Typo="Typo.subtitle1" Class="profile-person-name">@DisplayName</MudText>
                                <div class="profile-email-state">
                                    <MudIcon Icon="@(_profile.IsEmailConfirmed ? Icons.Material.Filled.Verified : Icons.Material.Filled.Info)"
                                             Color="@(_profile.IsEmailConfirmed ? Color.Success : Color.Warning)" Size="Size.Small" />
                                    <MudText Typo="Typo.caption">@(_profile.IsEmailConfirmed ? "Email verified" : "Email not verified")</MudText>
                                </div>
                            </div>
                        </div>

                        <MudDivider Class="profile-divider" />

                        @if (_editing)
                        {
                            <MudForm @ref="_form" Model="_edit" Validation="_editValidator.ToMudValidator()" Class="profile-edit-form">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      FullWidth="true" Required="true" RequiredError="First name is required."
                                                      MaxLength="80" For="@(() => _edit.FirstName)" @bind-Value="_edit.FirstName" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      FullWidth="true" Required="true" RequiredError="Last name is required."
                                                      MaxLength="80" For="@(() => _edit.LastName)" @bind-Value="_edit.LastName" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Phone number" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      FullWidth="true" MaxLength="16" InputType="InputType.Telephone"
                                                      For="@(() => _edit.PhoneNumber)" @bind-Value="_edit.PhoneNumber"
                                                      HelperText="Indian mobile number: 10 digits, with optional +91 prefix." />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Bio" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      FullWidth="true" Lines="3" MaxLength="600" Counter="600"
                                                      For="@(() => _edit.Bio)" @bind-Value="_edit.Bio" Placeholder="Tell people a little about yourself." />
                                    </MudItem>
                                </MudGrid>
                                <div class="profile-form-actions">
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="_saving" OnClick="CancelEdit">Cancel</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_saving"
                                               OnClick="SaveProfileAsync" Class="profile-primary-button">
                                        @if (_saving)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" /><span>Saving</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-1" /><span>Save changes</span>
                                        }
                                    </MudButton>
                                </div>
                            </MudForm>
                        }
                        else
                        {
                            <div class="profile-info-list">
                                <div class="profile-info-row">
                                    <div class="profile-info-copy">
                                        <MudText Typo="Typo.overline" Class="profile-field-label">FULL NAME</MudText>
                                        <MudText Typo="Typo.body2" Class="profile-field-value">@ValueOrFallback(DisplayName)</MudText>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="profile-row-edit" OnClick="BeginEdit">Edit</MudButton>
                                </div>
                                <MudDivider />
                                <div class="profile-info-row">
                                    <div class="profile-info-copy">
                                        <MudText Typo="Typo.overline" Class="profile-field-label">EMAIL</MudText>
                                        <MudText Typo="Typo.body2" Class="profile-field-value">@_profile.Email</MudText>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="@(_profile.IsEmailConfirmed ? Color.Success : Color.Warning)"
                                             Variant="Variant.Outlined">@(_profile.IsEmailConfirmed ? "Verified" : "Unverified")</MudChip>
                                </div>
                                <MudDivider />
                                <div class="profile-info-row">
                                    <div class="profile-info-copy">
                                        <MudText Typo="Typo.overline" Class="profile-field-label">PHONE</MudText>
                                        <MudText Typo="Typo.body2" Class="profile-field-value">@ValueOrFallback(_profile.PhoneNumber)</MudText>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="profile-row-edit" OnClick="BeginEdit">Edit</MudButton>
                                </div>
                                <MudDivider />
                                <div class="profile-info-row profile-info-row-bio">
                                    <div class="profile-info-copy">
                                        <MudText Typo="Typo.overline" Class="profile-field-label">BIO</MudText>
                                        <MudText Typo="Typo.body2" Class="profile-field-value profile-bio-value">
                                            @ValueOrFallback(_profile.Bio, "Add a short introduction about yourself.")
                                        </MudText>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="profile-row-edit" OnClick="BeginEdit">Edit</MudButton>
                                </div>
                            </div>
                        }

                        <div class="profile-account-meta">
                            <MudText Typo="Typo.caption">Member since @_profile.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</MudText>
                            @if (_profile.Roles.Count > 0)
                            {
                                <div class="profile-role-list">
                                    @foreach (var role in _profile.Roles)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">@role</MudChip>
                                    }
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="profile-card notification-card" Elevation="0">
                        <div class="profile-card-heading">
                            <div class="profile-card-heading-left">
                                <span class="profile-card-icon"><MudIcon Icon="@Icons.Material.Filled.NotificationsNone" /></span>
                                <div>
                                    <MudText Typo="Typo.h6" Class="profile-card-title">Notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="profile-card-subtitle">Choose how XQARE can keep you updated</MudText>
                                </div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Coming soon</MudChip>
                        </div>
                        <MudDivider Class="profile-divider" />
                        <div class="notification-list">
                            <div class="notification-row">
                                <div class="notification-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Email Notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">Get platform updates via email</MudText>
                                </div>
                                <MudSwitch T="bool" Checked="false" Disabled="true" Color="Color.Warning" Class="notification-toggle" />
                            </div>
                            <MudDivider />
                            <div class="notification-row">
                                <div class="notification-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Push Notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">Browser push alerts</MudText>
                                </div>
                                <MudSwitch T="bool" Checked="false" Disabled="true" Color="Color.Warning" Class="notification-toggle" />
                            </div>
                            <MudDivider />
                            <div class="notification-row">
                                <div class="notification-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Mentor Reminders</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">Reminders before mentoring sessions</MudText>
                                </div>
                                <MudSwitch T="bool" Checked="false" Disabled="true" Color="Color.Warning" Class="notification-toggle" />
                            </div>
                            <MudDivider />
                            <div class="notification-row">
                                <div class="notification-copy">
                                    <MudText Typo="Typo.body2" Class="notification-title">Weekly Digest</MudText>
                                    <MudText Typo="Typo.caption" Class="notification-description">A summary of your weekly activity</MudText>
                                </div>
                                <MudSwitch T="bool" Checked="false" Disabled="true" Color="Color.Warning" Class="notification-toggle" />
                            </div>
                        </div>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="notification-note">
                            Notification preferences will be enabled when XQARE's notification delivery is available.
                        </MudAlert>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
</section>

@code {
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private MyProfileResponse? _profile;
    private UpdateMyProfileRequest _edit = new();
    private readonly UpdateMyProfileRequestValidator _editValidator = new();
    private MudForm? _form;

    private string DisplayName
    {
        get
        {
            if (_profile == null) return "XQARE member";
            var name = string.Join(" ", new[] { _profile.FirstName, _profile.LastName }
                .Where(x => !string.IsNullOrWhiteSpace(x)));
            return string.IsNullOrWhiteSpace(name) ? (_profile.DisplayName ?? "XQARE member") : name;
        }
    }

    private string Initials
    {
        get
        {
            var names = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (names.Length > 1) return string.Concat(names[0][0], names[^1][0]).ToUpperInvariant();
            return names.Length == 1 ? names[0][..1].ToUpperInvariant() : "X";
        }
    }

    protected override Task OnInitializedAsync() => LoadProfileAsync();

    private async Task LoadProfileAsync()
    {
        _loading = true;
        try
        {
            _profile = await ProfileService.GetMyProfileAsync();
            if (_profile.IsSuccess) CopyProfileToEdit();
            else Snackbar.Add(_profile.Message, Severity.Error);
        }
        catch
        {
            _profile = null;
            Snackbar.Add("Your profile could not be loaded. Please retry.", Severity.Error);
        }
        finally { _loading = false; }
    }

    private void CopyProfileToEdit()
    {
        if (_profile == null) return;
        _edit = new UpdateMyProfileRequest
        {
            FirstName = _profile.FirstName, LastName = _profile.LastName,
            PhoneNumber = _profile.PhoneNumber, Bio = _profile.Bio
        };
    }

    private void BeginEdit() { CopyProfileToEdit(); _editing = true; }
    private void CancelEdit() { CopyProfileToEdit(); _editing = false; }

    private async Task SaveProfileAsync()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }
        _saving = true;
        try
        {
            var response = await ProfileService.UpdateMyProfileAsync(_edit);
            if (!response.IsSuccess) { Snackbar.Add(response.Message, Severity.Error); return; }
            _profile = response;
            CopyProfileToEdit();
            _editing = false;
            Snackbar.Add(response.Message, Severity.Success);
        }
        catch { Snackbar.Add("Your profile could not be saved. Please try again.", Severity.Error); }
        finally { _saving = false; }
    }

    private static string ValueOrFallback(string? value, string fallback = "Not added yet")
        => string.IsNullOrWhiteSpace(value) ? fallback : value;
}
