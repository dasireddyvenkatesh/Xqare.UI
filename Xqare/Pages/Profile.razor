@page "/profile"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Profile | XQARE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Elevation="1" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-2">My Profile</MudText>
        <MudText Color="Color.Secondary" Class="mb-6">
            Your account profile. Profile editing and mentorship preferences can be added later.
        </MudText>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.subtitle2">Email</MudText>
                <MudText>@(_email ?? "Email not available")</MudText>
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Account roles</MudText>
                @if (_roles.Count == 0)
                {
                    <MudText Color="Color.Warning">
                        No role claim was found in this session. Please sign out and sign in again after the default role is configured.
                    </MudText>
                }
                else
                {
                    <MudStack Direction="Row" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var role in _roles)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@role</MudChip>
                        }
                    </MudStack>
                }
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _isLoading = true;
    private string? _email;
    private List<string> _roles = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
        _roles = user.Claims
            .Where(c => c.Type == ClaimTypes.Role || c.Type == "role" || c.Type.EndsWith("/role", StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        _isLoading = false;
    }
}
