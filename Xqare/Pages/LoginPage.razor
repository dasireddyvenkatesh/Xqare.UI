@page "/login"
@using MudBlazor
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Auth
@using Xqare.BusinessLayer.Validators
@using Xqare.BusinessLayer.Validators.FluentValidation
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IAuthService AuthService

<section>

    <MudGrid Class="login-wrapper" GutterSize="0">

        <!-- LEFT PANEL -->
        <MudItem xs="12" md="6" Class="left-panel d-none d-md-flex">
            <MudStack Class="left-content">

                <MudText Class="logo-text">
                    X<span>QARE</span>
                </MudText>

                <MudText Class="hero-title mt-8">
                    Welcome back to your <span>career growth</span> journey
                </MudText>

                <MudText Class="hero-sub mt-4">
                    Built for every stage of your career — from first step to leadership.
                </MudText>

                @*                 <MudStack Direction="Row" Spacing="8" Class="stats mt-10">
                    <MudStack>
                        <MudText Class="stat-number">5,000+</MudText>
                        <MudText Class="stat-label">Members</MudText>
                    </MudStack>

                    <MudStack>
                        <MudText Class="stat-number">200+</MudText>
                        <MudText Class="stat-label">Mentors</MudText>
                    </MudStack>

                    <MudStack>
                        <MudText Class="stat-number">92%</MudText>
                        <MudText Class="stat-label">Growth Rate</MudText>
                    </MudStack>
                </MudStack> *@

            </MudStack>
        </MudItem>

        <!-- RIGHT PANEL -->
        <MudItem xs="12" md="6" Class="right-panel">

            <MudPaper Elevation="0" Class="auth-container">
                <MudText Class="mobile-logo d-block d-md-none">
                    X<span>QARE</span>
                </MudText>
                <MudText Class="auth-title">
                    Sign in to your account
                </MudText>

                <MudText Class="auth-subtitle">
                    Don’t have an account?
                    <MudButton Href="/register">Create one free</MudButton>
                </MudText>

                @if (!isMfaStep)
                {
                    <!-- SOCIAL 2x2 -->
                    <MudGrid Class="social-grid mt-6">
                        <MudItem xs="6">
                            <MudButton FullWidth Class="social-btn"
                                       StartIcon="@Icons.Custom.Brands.Google"
                                       OnClick="LoginWithGoogle">
                                Google
                            </MudButton>
                        </MudItem>

                        <MudItem xs="6">
                            <MudButton FullWidth Class="social-btn"
                                       StartIcon="@Icons.Custom.Brands.GitHub"
                                       OnClick="LoginWithGitHub">
                                GitHub
                            </MudButton>
                        </MudItem>

                        <MudItem xs="6">
                            <MudButton FullWidth Class="social-btn"
                                       StartIcon="@Icons.Custom.Brands.LinkedIn"
                                       OnClick="LoginWithLinkedIn">
                                LinkedIn
                            </MudButton>
                        </MudItem>

                        <MudItem xs="6">
                            <MudButton FullWidth Class="social-btn"
                                       StartIcon="@Icons.Custom.Brands.Twitter"
                                       OnClick="LoginWithTwitter">
                                Twitter
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <MudGrid Class="mt-6 mb-6 align-center">

                        <MudItem xs="3">
                            <MudDivider Class="divider-line-1" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudText Class="divider-text d-flex justify-center">
                                OR CONTINUE WITH EMAIL
                            </MudText>
                        </MudItem>

                        <MudItem xs="3">
                            <MudDivider Class="divider-line-2" />
                        </MudItem>

                    </MudGrid>

                    <!-- LOGIN FORM -->
                    <MudForm @ref="form"
                             Model="loginRequest"
                             Validation="loginValidator.ToMudValidator()"
                             OnValidSubmit="Submit">

                        <MudTextField Label="Email Address"
                                      MaxLength="256"
                                      InputType="InputType.Email"
                                      AutoComplete="username"
                                      Variant="Variant.Outlined"
                                      @bind-Value="loginRequest.Email"
                                      For="@(() => loginRequest.Email)"
                                      Immediate="true" />

                        <MudTextField Label="Password"
                                      MaxLength="1024"
                                      AutoComplete="current-password"
                                      Variant="Variant.Outlined"
                                      @bind-Value="loginRequest.Password"
                                      For="@(() => loginRequest.Password)"
                                      InputType="@(showPassword? InputType.Text: InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="TogglePassword" />

                        <div class="forgot-password-row">
                            <MudButton Href="/forgot-password"
                                       Variant="Variant.Text"
                                       Class="forgot-password-link">
                                Forgot password?
                            </MudButton>
                        </div>

                        <MudButton Disabled="@_processing"
                                   FullWidth
                                   Variant="Variant.Filled"
                                   OnClick="Submit"
                                   Class="login-btn">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="1">

                                @if (_processing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <MudText>Processing...</MudText>
                                }
                                else
                                {
                                    <MudText>Sign In →</MudText>
                                }

                            </MudStack>
                        </MudButton>
                        <MudText Class="security-text">
                            🔒 Your data is protected with enterprise-grade encryption
                        </MudText>
                    </MudForm>
                }
                else
                {
                    <MudForm @ref="form"
                             Model="mfaRequest"
                             Validation="mfaValidator.ToMudValidator()"
                             OnValidSubmit="Submit"
                             Class="mt-6">
                        <MudButton Variant="Variant.Text" OnClick="BackToLogin" Class="back-btn">
                            ← Back to login
                        </MudButton>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-2">
                            @if (isRecoveryCodeStep)
                            {
                                <span>Enter one of your saved recovery codes.</span>
                            }
                            else
                            {
                                <span>Open your authenticator app and enter the current six-digit code.</span>
                            }
                        </MudText>
                        <MudTextField Label="@(isRecoveryCodeStep ? "Recovery code" : "Authenticator code")"
                                      Variant="Variant.Outlined"
                                      @bind-Value="mfaRequest.Code"
                                      For="@(() => mfaRequest.Code)"
                                      MaxLength="@(isRecoveryCodeStep ? 36 : 6)"
                                      AutoComplete="one-time-code"
                                      Immediate="true"
                                      InputMode="@(isRecoveryCodeStep ? InputMode.text : InputMode.numeric)" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="ToggleRecoveryCode" Class="resend-btn">
                            @(isRecoveryCodeStep ? "Use authenticator code" : "Use a recovery code")
                        </MudButton>
                        <MudButton Disabled="@_processing" FullWidth Variant="Variant.Filled"
                                   OnClick="Submit" Class="login-btn">
                            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="1">
                                @if (_processing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    <MudText>Verifying...</MudText>
                                }
                                else
                                {
                                    <MudText>Verify and Sign In →</MudText>
                                }
                            </MudStack>
                        </MudButton>
                    </MudForm>
                }

            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {

    MudForm form = new();
    LoginRequest loginRequest = new();
    VerifyMfaChallengeRequest mfaRequest = new();

    LoginRequestValidator loginValidator = new();
    VerifyMfaChallengeRequestValidator mfaValidator = new();

    private bool _processing = false;
    bool isMfaStep = false;
    bool isRecoveryCodeStep = false;
    string? mfaChallengeToken;
    bool showPassword;


    void TogglePassword() => showPassword = !showPassword;

    async Task Submit()
    {
        if (_processing)
            return;

        _processing = true;
        try
        {
            await form.ValidateAsync();
            if (!form.IsValid)
                return;

            if (!isMfaStep)
            {
                // 🔐 CALL LOGIN API
                var response = await AuthService.LoginAsync(loginRequest);

                if (!response.IsSuccess)
                {
                    Snackbar.Add(response.Message ?? "Invalid email or password. Please try again.", Severity.Error);
                    return;
                }

                if (response.RequiresMfa)
                {
                    mfaChallengeToken = response.MfaChallengeToken;
                    mfaRequest.ChallengeToken = mfaChallengeToken;
                    mfaRequest.Code = string.Empty;
                    mfaRequest.Factor = "totp";
                    isRecoveryCodeStep = false;
                    isMfaStep = true;
                    Snackbar.Add(response.Message, Severity.Info);
                    return;
                }

                if (string.IsNullOrWhiteSpace(response.AccessToken))
                {
                    Snackbar.Add("Login did not return a valid session. Please try again.", Severity.Error);
                    return;
                }

                NavigateAfterLogin();
            }
            else
            {
                var otpResponse = await AuthService.VerifyMfaChallengeAsync(mfaRequest);

                if (!otpResponse.IsSuccess)
                {
                    Snackbar.Add(otpResponse.Message ?? "Verification failed.", Severity.Error);
                    return;
                }
                if (string.IsNullOrWhiteSpace(otpResponse.AccessToken))
                {
                    Snackbar.Add(otpResponse.Message ?? "MFA verification did not return a valid session.", Severity.Error);
                    return;
                }
                Snackbar.Add(otpResponse.Message ?? "Login successful.", Severity.Success);
                Nav.NavigateTo("/dashboard");
            }
        }
        catch
        {
            Snackbar.Add("Something went wrong. Please try again.", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    void BackToLogin()
    {
        isMfaStep = false;
        isRecoveryCodeStep = false;
        mfaChallengeToken = null;
        mfaRequest = new() { Factor = "totp" };
    }

    void ToggleRecoveryCode()
    {
        isRecoveryCodeStep = !isRecoveryCodeStep;
        mfaRequest.Factor = isRecoveryCodeStep ? "recovery" : "totp";
        mfaRequest.Code = string.Empty;
    }
    private void NavigateAfterLogin()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Nav.ToAbsoluteUri(Nav.Uri).Query);
        query.TryGetValue("returnUrl", out var returnUrlValue);
        var target = Xqare.BusinessLayer.Classes.Auth.LocalReturnUrlHelper
            .GetSafeReturnUrl(returnUrlValue.ToString());

        Nav.NavigateTo(target);
    }

    async Task LoginWithGoogle()
    {
        await AuthService.LoginWithGoogle();

    }

    async Task LoginWithGitHub()
    {
        await AuthService.LoginWithGitHub();
    }

    async Task LoginWithLinkedIn()
    {
        await AuthService.LoginWithLinkedIn();
    }

    async Task LoginWithTwitter()
    {
        await AuthService.LoginWithTwitter();
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        // OAuth MFA returns with an API-hosted HttpOnly challenge cookie.
        // No user identifier or challenge token is carried in the URL.
        if (query.TryGetValue("mfa", out var mfaValue) &&
            string.Equals(mfaValue.ToString(), "required", StringComparison.OrdinalIgnoreCase))
        {
            mfaRequest = new VerifyMfaChallengeRequest { Factor = "totp" };
            isMfaStep = true;
            isRecoveryCodeStep = false;

            if (query.TryGetValue("message", out var messageValue) &&
                !string.IsNullOrWhiteSpace(messageValue.ToString()))
                Snackbar.Add(messageValue.ToString(), Severity.Info);

            Nav.NavigateTo("/login", forceLoad: false, replace: true);
            return Task.CompletedTask;
        }

        if (query.TryGetValue("externalLogin", out var externalValue))
        {
            var externalStatus = externalValue.ToString();
            if (string.Equals(externalStatus, "success", StringComparison.OrdinalIgnoreCase))
            {
                // Remove the one-time code from the address bar before exchanging it.
                query.TryGetValue("code", out var codeValue);
                Nav.NavigateTo("/login", forceLoad: false, replace: true);

                var exchange = await AuthService.CompleteExternalLoginAsync(codeValue.ToString());
                if (exchange.IsSuccess && !string.IsNullOrWhiteSpace(exchange.AccessToken))
                {
                    Snackbar.Add("Signed in successfully.", Severity.Success);
                    Nav.NavigateTo("/dashboard", replace: true);
                }
                else
                {
                    Snackbar.Add(exchange.Message ?? "Google sign-in could not be completed. Please try again.", Severity.Error);
                }

                return;
            }

            if (string.Equals(externalStatus, "failed", StringComparison.OrdinalIgnoreCase))
            {
                var error = query.TryGetValue("message", out var errorValue)
                    ? errorValue.ToString()
                    : "External sign-in failed. Please try again.";
                // Keep the login page mounted after queuing the Snackbar.
                // MudBlazor is configured with ClearAfterNavigation=true, so navigating
                // immediately here would clear the notification before it is visible.
                Snackbar.Add(error, Severity.Error);
            }
        }

        return;
    }
}