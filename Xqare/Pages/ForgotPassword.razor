@page "/forgot-password"
@using MudBlazor
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Auth
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<section>
    <MudGrid Class="login-wrapper" GutterSize="0">
        <MudItem xs="12" md="6" Class="left-panel d-none d-md-flex">
            <MudStack Class="left-content">
                <MudText Class="logo-text">X<span>QARE</span></MudText>
                <MudText Class="hero-title mt-8">Get back to your <span>career growth</span> journey</MudText>
                <MudText Class="hero-sub mt-4">We'll help you securely restore access to your account.</MudText>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="6" Class="right-panel">
            <MudPaper Elevation="0" Class="auth-container">
                <MudText Class="mobile-logo d-block d-md-none">X<span>QARE</span></MudText>
                <MudText Class="auth-title">Forgot your password?</MudText>
                <MudText Class="auth-subtitle">Enter the email address associated with your XQARE account.</MudText>

                @if (!_requestSent)
                {
                    <MudForm @ref="form" Model="request">
                        <MudTextField Label="Email Address"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      @bind-Value="request.Email"
                                      Required="true"
                                      RequiredError="Email address is required."
                                      Validation="@(new Func<string, string?>(ValidateEmail))"
                                      Immediate="true" />

                        <MudButton Disabled="@_processing"
                                   FullWidth="true"
                                   Variant="Variant.Filled"
                                   OnClick="Submit"
                                   Class="recovery-btn">
                            @if (_processing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send Reset Link</span>
                            }
                        </MudButton>
                    </MudForm>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-6">
                        @confirmationMessage
                    </MudAlert>
                    <MudText Class="recovery-note">
                        For security, this message is the same whether or not the email address is registered.
                    </MudText>
                }

                <MudButton Href="/login" Variant="Variant.Text" Class="back-login-btn" FullWidth="true">
                    ← Back to sign in
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {
    private MudForm? form;
    private readonly ForgotPasswordRequest request = new();
    private bool _processing;
    private bool _requestSent;
    private string confirmationMessage = "If an account with that email exists, we'll send a password reset link shortly.";

    private static string? ValidateEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Email address is required.";

        return new System.ComponentModel.DataAnnotations.EmailAddressAttribute()
            .IsValid(value.Trim()) ? null : "Enter a valid email address.";
    }

    private async Task Submit()
    {
        if (_processing || form == null)
            return;

        _processing = true;
        try
        {
            await form.ValidateAsync();
            if (!form.IsValid)
                return;

            var result = await AuthService.ForgotPasswordAsync(request);
            if (result.IsSuccess)
            {
                confirmationMessage = result.Message;
                _requestSent = true;
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("The request could not be completed. Please try again.", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}
