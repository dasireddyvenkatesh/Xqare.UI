@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Xqare.BusinessLayer.Interfaces.Auth
@using Xqare.Wrappers.CommonWrapper
@using Xqare.Wrappers.HomePageWrapper
@inject IAuthService AuthService
@inject ITokenService TokenService
@inject AuthenticationStateProvider AuthStateProvider

<HeaderWrapper/>
<HeroContentUpdated/>
<FeaturesWrapper/>
<ActivityCard />
<HowItWorksWrapper/>
<FAQWrapper/>
<Footer/>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            // Backfill the non-sensitive hint for users who already have a
            // valid tab token from a session established before this feature.
            if (!await TokenService.HasSessionHintAsync())
            {
                var currentState = await AuthStateProvider.GetAuthenticationStateAsync();
                if (currentState.User.Identity?.IsAuthenticated == true)
                {
                    await TokenService.MarkSessionHintAsync();
                    return;
                }

                return;
            }

            // Anonymous visitors do not trigger session restoration. Returning
            // users with a prior session hint restore through the existing API flow.
            await AuthService.InitializeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home session restoration failed: {ex.Message}");
        }
    }
}

