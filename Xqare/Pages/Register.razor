@page "/register"
@using Xqare.BusinessLayer.Constants.Messages
@inject RateLimitState RateLimits
@implements IDisposable
@using System.Timers
@using MudBlazor
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Auth
@using Xqare.BusinessLayer.Validators
@using Xqare.BusinessLayer.Validators.FluentValidation
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IAuthService AuthService

<section>

    <MudGrid Class="login-wrapper" GutterSize="0">

        <!-- LEFT PANEL -->
        <MudItem xs="12" md="6" Class="left-panel d-none d-md-flex">
            <MudStack Class="left-content">

                <MudText Class="logo-text">
                    X<span>QARE</span>
                </MudText>

                @if (ShowTrialBadge)
                {
                    <MudChip T="string" Color="Color.Warning"
                             Variant="Variant.Text"
                             Class="trial-badge mt-6">
                        6-MONTH FREE TRIAL
                    </MudChip>
                }

                <MudText Class="hero-title mt-8">
                    Start your <span>career growth</span> journey today
                </MudText>

                @*                 <MudText Class="hero-sub mt-4">
                    Join 5,000+ professionals transforming their careers with XQARE.
                </MudText>

                <MudStack Spacing="3" Class="mt-8 benefits">
                    <MudText>✔ Full mentor access for 6 months</MudText>
                    <MudText>✔ Community forums & networking</MudText>
                    <MudText>✔ Curated job board access</MudText>
                    <MudText>✔ Career resources & learning paths</MudText>
                </MudStack> *@

                @if (ShowTrialPrice)
                {
                    <MudPaper Class="trial-box mt-8" Elevation="0">
                        <MudText Class="trial-price">
                            £0 <span>/ 6 months</span>
                        </MudText>
                        <MudText Class="trial-note">
                            NO CREDIT CARD REQUIRED
                        </MudText>
                    </MudPaper>
                }

            </MudStack>
        </MudItem>

        <!-- RIGHT PANEL -->
        <MudItem xs="12" md="6" Class="right-panel">

            <MudPaper Elevation="0" Class="auth-container">

                <MudText Class="mobile-logo d-block d-md-none">
                    X<span>QARE</span>
                </MudText>

                <MudText Class="auth-title">
                    Create your free account
                </MudText>

                <MudText Class="auth-subtitle">
                    Already have an account?
                    <MudButton Href="/login">Sign in</MudButton>
                </MudText>
                <RateLimitNotice Policy="auth-otp-ip" OnTick="HandleRateLimitTick" />

                @if (!isOtpStep)
                {

                    <!-- SOCIAL -->
                    <MudGrid Class="social-grid mt-6" Spacing="2">
                        <MudItem xs="6" sm="6">
                            <MudButton FullWidth Class="social-btn social-google"
                           Disabled='@(!string.IsNullOrWhiteSpace(_activeProvider))'
                           OnClick='@(() => LoginWithProviderAsync("google"))'>
                        <span class="social-google-content">
                            @if (_activeProvider != "google")
                            {
                                <span class="google-icon-stack" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Custom.Brands.Google" Class="google-icon-layer google-icon-red" />
                                    <MudIcon Icon="@Icons.Custom.Brands.Google" Class="google-icon-layer google-icon-yellow" />
                                    <MudIcon Icon="@Icons.Custom.Brands.Google" Class="google-icon-layer google-icon-green" />
                                    <MudIcon Icon="@Icons.Custom.Brands.Google" Class="google-icon-layer google-icon-blue" />
                                </span>
                            }
                            <LoadingButtonContent IsLoading='@(_activeProvider == "google")' LoadingText="Connecting…">Google</LoadingButtonContent>
                        </span>
                    </MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudButton FullWidth Class="social-btn social-github"
                                       StartIcon='@(_activeProvider == "github" ? null : Icons.Custom.Brands.GitHub)'
                                       Disabled='@(!string.IsNullOrWhiteSpace(_activeProvider))'
                                       OnClick='@(() => LoginWithProviderAsync("github"))'>
                                <LoadingButtonContent IsLoading='@(_activeProvider == "github")' LoadingText="Connecting…">GitHub</LoadingButtonContent>
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudButton FullWidth Class="social-btn social-linkedin"
                                       StartIcon='@(_activeProvider == "linkedin" ? null : Icons.Custom.Brands.LinkedIn)'
                                       Disabled='@(!string.IsNullOrWhiteSpace(_activeProvider))'
                                       OnClick='@(() => LoginWithProviderAsync("linkedin"))'>
                                <LoadingButtonContent IsLoading='@(_activeProvider == "linkedin")' LoadingText="Connecting…">LinkedIn</LoadingButtonContent>
                            </MudButton>
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudButton FullWidth Class="social-btn social-twitter"
                                       Disabled='@(!string.IsNullOrWhiteSpace(_activeProvider))'
                                       StartIcon='@(_activeProvider == "twitter" ? null : Icons.Custom.Brands.Twitter)'
                                       OnClick='@(() => LoginWithProviderAsync("twitter"))'>
                                <LoadingButtonContent IsLoading='@(_activeProvider == "twitter")' LoadingText="Connecting…">
                                    Twitter
                                </LoadingButtonContent>
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <!-- DIVIDER -->
                    <MudGrid Class="mt-6 mb-6 align-center">
                        <MudItem xs="3">
                            <MudDivider Class="divider-line-1" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Class="divider-text d-flex justify-center">
                                OR SIGN UP WITH EMAIL
                            </MudText>
                        </MudItem>
                        <MudItem xs="3">
                            <MudDivider Class="divider-line-2" />
                        </MudItem>
                    </MudGrid>

                    <!-- FORM -->
                    <MudForm @ref="form"
                             Model="registerRequest"
                             Validation="validationRules.ToMudValidator()">

                        <MudTextField Label="Full Name"
                                      MaxLength="100"
                                      AutoComplete="name"
                                      Variant="Variant.Outlined"
                                      @bind-Value="registerRequest.FullName"
                                      For="@(() => registerRequest.FullName)"
                                      HelperText="@RegistrationValidationMessages.FullNameHelper"
                                      HelperTextOnFocus="true"
                                      Immediate="true" />

                        <MudTextField Label="Email Address"
                                      MaxLength="256"
                                      AutoComplete="email"
                                      Immediate="true"
                                      InputType="InputType.Email"
                                      Variant="Variant.Outlined"
                                      @bind-Value="registerRequest.Email"
                                      For="@(() => registerRequest.Email)"
                                      HelperText="@RegistrationValidationMessages.EmailHelper"
                                      HelperTextOnFocus="true" />

                        <MudButton Disabled="@(_processing || !string.IsNullOrWhiteSpace(_activeProvider) || isRegistrationRetryDisabled || RateLimits.IsBlocked("auth-otp-ip"))"
                                   FullWidth
                                   Variant="Variant.Filled"
                                   OnClick="Submit"
                                   Class="register-btn">
                            <LoadingButtonContent IsLoading="_processing" LoadingText='@(isOtpStep ? "Verifying your email…" : "Creating your account…")'>@(isRegistrationRetryDisabled ? $"Try again in {FormatCountdown(secondsRemaining)}" : "Register")</LoadingButtonContent>
                        </MudButton>

                        @if (ShowNoCardNote)
                        {
                            <MudText Class="security-text">
                                🔒 No credit card required · Cancel anytime
                            </MudText>
                        }

                        <MudText Class="signup-text">
                            By signing up, you agree to our
                            <MudLink Href="/terms" Class="signup-link">Terms of Service</MudLink>
                            and
                            <MudLink Href="/privacy" Class="signup-link">Privacy Policy</MudLink>.
                        </MudText>

                    </MudForm>
                }
                else
                {
                    <!-- OTP FORM -->
                    <MudForm @ref="form"
                             Model="otpRequest"
                             Validation="registrationOtpValidator.ToMudValidator()"
                             Class="mt-6">

                        <MudButton Variant="Variant.Text"
                                   OnClick="BackToRegister"
                                   Class="back-btn">
                            ← Back to registration
                        </MudButton>

                        <MudTextField Label="Email" MaxLength="256"
                                      Value="otpRequest.Email"
                                      For="@(() => otpRequest.Email)"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />

                        <MudTextField Label="Enter OTP"
                                      Variant="Variant.Outlined"
                                      @bind-Value="otpRequest.OtpCode"
                                      For="@(() => otpRequest.OtpCode)"
                                      MaxLength="6"
                                      AutoComplete="one-time-code"
                                      Immediate="true"
                                      InputMode="InputMode.numeric" />

                        <MudTextField Label="Set Password"
                                      MaxLength="128"
                                      AutoComplete="new-password"
                                      Variant="Variant.Outlined"
                                      InputType="@(showPassword ? InputType.Text : InputType.Password)"
                                      @bind-Value="otpRequest.Password"
                                      For="@(() => otpRequest.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="TogglePassword"
                                      HelperText="@RegistrationValidationMessages.PasswordRequirementsHelper" />

                        <MudTextField Label="Confirm Password"
                                      MaxLength="128"
                                      AutoComplete="new-password"
                                      Variant="Variant.Outlined"
                                      InputType="@(showConfirmPassword ? InputType.Text : InputType.Password)"
                                      @bind-Value="otpRequest.ConfirmPassword"
                                      For="@(() => otpRequest.ConfirmPassword)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleConfirmPassword" />

                        <MudButton Variant="Variant.Text"
                                   Disabled="@(_processing || _resending || isResendDisabled || RateLimits.IsBlocked("auth-otp-ip"))"
                                   OnClick="ResendOtp"
                                   Class="resend-btn">
                            @if (_resending)
                            {
                                <span>Sending...</span>
                            }
                            else if (isResendDisabled)
                            {
                                <span>Resend in @FormatCountdown(secondsRemaining)</span>
                            }
                            else
                            {
                                <span>Resend OTP</span>
                            }
                        </MudButton>

                        <MudButton Disabled="@(_processing || isOtpLocked || RateLimits.IsBlocked("auth-otp-ip"))"
                                   FullWidth
                                   Variant="Variant.Filled"
                                   OnClick="Submit"
                                   Class="register-btn">
                            <LoadingButtonContent IsLoading="_processing" LoadingText="Processing…">@(isOtpLocked ? $"Locked for {FormatCountdown(secondsRemaining)}" : "Verify OTP →")</LoadingButtonContent>
                        </MudButton>

                    </MudForm>
                }

            </MudPaper>
        </MudItem>

    </MudGrid>
</section>

@code {

    [Parameter] public bool ShowTrialBadge { get; set; } = false;
    [Parameter] public bool ShowTrialPrice { get; set; } = false;
    [Parameter] public bool ShowNoCardNote { get; set; } = false;

    MudForm form = new();
    RegisterRequest registerRequest = new();
    VerifyRegisterEmailOtpRequest otpRequest = new();

    RegisterRequestValidator validationRules = new();
    RegistrationOtpRequestValidator registrationOtpValidator = new();

    private bool _processing = false;
    private string? _activeProvider;
    bool isOtpStep = false;
    bool showPassword;
    bool showConfirmPassword;
    bool isResendDisabled = true;
    bool isRegistrationRetryDisabled;
    bool _resending;
    bool isOtpLocked;
    int secondsRemaining = 60;
    Timer timer = new();

    private Task HandleRateLimitTick() => InvokeAsync(StateHasChanged);

    private async Task LoginWithProviderAsync(string provider)
    {
        if (!string.IsNullOrWhiteSpace(_activeProvider))
            return;

        _activeProvider = provider;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            switch (provider)
            {
                case "google":
                    await AuthService.LoginWithGoogle();
                    break;
                case "github":
                    await AuthService.LoginWithGitHub();
                    break;
                case "linkedin":
                    await AuthService.LoginWithLinkedIn();
                    break;
                case "twitter":
                    await AuthService.LoginWithTwitter();
                    break;
            }
        }
        catch
        {
            Snackbar.Add(CommonMessages.GenericFailure, Severity.Error);
        }
        finally
        {
            _activeProvider = null;
        }
    }

    void TogglePassword() => showPassword = !showPassword;
    void ToggleConfirmPassword() => showConfirmPassword = !showConfirmPassword;

    async Task Submit()
    {
        // Guard against repeated submissions while a request is in progress.
        if (_processing)
            return;

        _processing = true;
        try
        {
            await form.ValidateAsync();
            if (!form.IsValid)
                return;

            if (!isOtpStep)
            {
                // STEP 1: Create a pending account and request email verification.
                var response = await AuthService.RegisterAsync(registerRequest);

                if (response.RequiresEmailVerification && response.CanVerifyExistingOtp)
                {
                    otpRequest = new VerifyRegisterEmailOtpRequest
                    {
                        Email = string.IsNullOrWhiteSpace(response.Email)
                            ? registerRequest.Email
                            : response.Email
                    };

                    isOtpStep = true;
                    Snackbar.Add(
                        response.Message ?? RegistrationMessages.VerificationCodeSentPrompt,
                        response.IsSuccess ? Severity.Info : Severity.Warning);

                    StartTimer(response.RetryAfterSeconds ?? 60);
                    return;
                }

                if (!response.IsSuccess)
                {
                    Snackbar.Add(response.Message ?? RegistrationMessages.StartFailed, Severity.Error);

                    // If delivery failed or the OTP is locked, keep the user on the
                    // registration step and use the server-provided retry interval.
                    if (response.RetryAfterSeconds is > 0)
                        StartTimer(response.RetryAfterSeconds.Value);

                    return;
                }

                Snackbar.Add(
                    response.Message ?? RegistrationMessages.CompletionFailed,
                    Severity.Error);
            }
            else
            {
                // STEP 2: VERIFY OTP and establish an authenticated session on the API.
                var otpResponse = await AuthService.VerifyRegistrationOtpAsync(otpRequest);

                if (!otpResponse.IsSuccess)
                {
                    Snackbar.Add(otpResponse.Message ?? RegistrationMessages.OtpVerificationFailed, Severity.Error);

                    if (otpResponse.RetryAfterSeconds is > 0)
                    {
                        isOtpLocked = true;
                        StartTimer(otpResponse.RetryAfterSeconds.Value);
                    }

                    return;
                }

                if (otpResponse.RequiresMfa)
                {
                    var message = Uri.EscapeDataString(otpResponse.Message ?? string.Empty);
                    Nav.NavigateTo($"/login?mfa=required&message={message}");
                    return;
                }

                if (string.IsNullOrWhiteSpace(otpResponse.AccessToken))
                {
                    Snackbar.Add(otpResponse.Message ?? RegistrationMessages.SessionMissing, Severity.Error);
                    Nav.NavigateTo("/login");
                    return;
                }

                Snackbar.Add(otpResponse.Message ?? RegistrationMessages.Success, Severity.Success);
                Nav.NavigateTo("/dashboard");
            }
        }
        catch
        {
            Snackbar.Add(CommonMessages.GenericFailure, Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    async Task ResendOtp()
    {
        if (_processing || _resending || isResendDisabled)
            return;

        _resending = true;
        try
        {
            var response = await AuthService.ResendOtpAsync(registerRequest.Email);
            Snackbar.Add(response.Message, response.IsSuccess ? Severity.Success : Severity.Error);

            if (response.CanVerifyExistingOtp)
            {
                StartTimer(response.RetryAfterSeconds ?? 60);
                return;
            }

            // No usable OTP remains (for example, delivery failed or the address is
            // temporarily locked). Return to the registration step and retry only after
            // the API's cooldown has elapsed.
            if (response.RetryAfterSeconds is > 0)
            {
                isOtpStep = false;
                otpRequest = new VerifyRegisterEmailOtpRequest();
                StartTimer(response.RetryAfterSeconds.Value);
            }
        }
        catch
        {
            Snackbar.Add(RegistrationMessages.ResendFailed, Severity.Error);
        }
        finally
        {
            _resending = false;
        }
    }

    private static string FormatCountdown(int totalSeconds)
    {
        var hours = totalSeconds / 3600;
        var minutes = (totalSeconds % 3600) / 60;
        var seconds = totalSeconds % 60;

        if (hours > 0)
            return $"{hours}h {minutes:D2}m";

        if (minutes > 0)
            return $"{minutes}m {seconds:D2}s";

        return $"{seconds}s";
    }

    void StartTimer(int durationSeconds = 60)
    {
        secondsRemaining = Math.Clamp(durationSeconds, 1, 86400);
        isResendDisabled = isOtpStep;
        isRegistrationRetryDisabled = !isOtpStep;

        timer?.Stop();
        timer?.Dispose();

        timer = new Timer(1000);
        timer.Elapsed += OnTimerTick;
        timer.Start();
    }

    void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            if (secondsRemaining > 1)
            {
                secondsRemaining--;
            }
            else
            {
                secondsRemaining = 0;
                isResendDisabled = false;
                isRegistrationRetryDisabled = false;
                isOtpLocked = false;
                timer.Stop();
            }

            StateHasChanged();
        });
    }

    void BackToRegister()
    {
        isOtpStep = false;
        otpRequest = new VerifyRegisterEmailOtpRequest();

        timer?.Stop();
        timer?.Dispose();
        isResendDisabled = false;
        isRegistrationRetryDisabled = false;
        isOtpLocked = false;
    }




    public void Dispose()
    {
        if (timer is null)
            return;

        timer.Elapsed -= OnTimerTick;
        timer.Stop();
        timer.Dispose();
    }
}