@page "/access-denied"
@layout AuthenticatedLayout
@inject NavigationManager Navigation

<PageTitle>Access Denied | XQARE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 70vh;">
    <MudPaper Elevation="0" Outlined="true" Class="pa-8 rounded-lg text-center">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h4">Access denied</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                You are signed in, but your account does not have permission to view this page.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoHome">
                Return to home
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private void GoHome() => Navigation.NavigateTo("/");
}