@page "/access-denied"
@layout AuthenticatedLayout

<PageTitle>Access Denied | XQARE</PageTitle>

<section class="access-denied-page" aria-labelledby="access-denied-title">
    <MudContainer MaxWidth="MaxWidth.False" Class="access-denied-container">
        <MudPaper Class="access-denied-card" Elevation="0">
            <div class="access-denied-icon">
                <MudIcon Icon="@Icons.Material.Filled.Lock" />
            </div>
            <MudText Typo="Typo.overline" Class="access-denied-eyebrow">403 · FORBIDDEN</MudText>
            <MudText Typo="Typo.h4" Class="access-denied-title" id="access-denied-title">
                You don't have access to this page
            </MudText>
            <MudText Typo="Typo.body2" Class="access-denied-description">
                You're signed in, but your account doesn't have the required access.
                If you think this is a mistake, contact your platform administrator.
            </MudText>
            <MudGrid Class="access-denied-actions" Spacing="2">
                <MudItem xs="12" sm="8" md="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Home" OnClick="GoHome"
                               Class="access-denied-primary">
                        Return to home
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
</section>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void GoHome() => Navigation.NavigateTo("/");
}
