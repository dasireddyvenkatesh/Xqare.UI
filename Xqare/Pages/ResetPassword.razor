@using Xqare.BusinessLayer.Constants.Messages
@page "/reset-password"
@inject RateLimitState RateLimits
@using MudBlazor
@using Microsoft.JSInterop
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Auth
@using Xqare.BusinessLayer.Validators
@using Xqare.BusinessLayer.Validators.FluentValidation
@inject IAuthService AuthService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<section>
    <MudGrid Class="login-wrapper" GutterSize="0">
        <MudItem xs="12" md="6" Class="left-panel d-none d-md-flex">
            <MudStack Class="left-content">
                <MudText Class="logo-text">X<span>QARE</span></MudText>
                <MudText Class="hero-title mt-8">Secure your <span>career journey</span></MudText>
                <MudText Class="hero-sub mt-4">Choose a new password to protect your XQARE account.</MudText>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="6" Class="right-panel">
            <MudPaper Elevation="0" Class="auth-container">
                <MudText Class="mobile-logo d-block d-md-none">X<span>QARE</span></MudText>
                <MudText Class="auth-title">Reset your password</MudText>

                @if (string.IsNullOrWhiteSpace(Token))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-6">
                        This password reset link is missing or invalid. Request a new link.
                    </MudAlert>
                    <MudButton Href="/forgot-password" Class="recovery-btn" FullWidth="true" Variant="Variant.Filled">
                        Request New Reset Link
                    </MudButton>
                }
                else if (_completed)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-6">
                        @_resultMessage
                    </MudAlert>
                    <MudButton Href="/login" Class="recovery-btn" FullWidth="true" Variant="Variant.Filled">
                        Continue to Sign In
                    </MudButton>
                }
                else
                {
                    <MudText Class="auth-subtitle">Create a new password for your account.</MudText>
                    <RateLimitNotice Policy="auth-recovery-ip" OnTick="HandleRateLimitTick" />
                    <MudForm @ref="form"
                             Model="request"
                             Validation="validator.ToMudValidator()"
                             OnValidSubmit="Submit">
                        <MudTextField Label="New Password"
                                      MaxLength="128"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      @bind-Value="request.Password"
                                      For="@(() => request.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="TogglePassword" />

                        <MudText Class="password-help">
                            At least 8 characters, including uppercase, lowercase, a number and a symbol.
                        </MudText>

                        <MudTextField Label="Confirm New Password"
                                      MaxLength="128"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      @bind-Value="request.ConfirmPassword"
                                      For="@(() => request.ConfirmPassword)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleConfirmPassword" />

                        <MudButton Disabled="@(_processing || RateLimits.IsBlocked("auth-recovery-ip"))"
                                   FullWidth="true"
                                   Variant="Variant.Filled"
                                   OnClick="Submit"
                                   Class="recovery-btn">
                            @if (_processing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span>Resetting...</span>
                            }
                            else
                            {
                                <span>Reset Password</span>
                            }
                        </MudButton>
                    </MudForm>
                }

                @if (!_completed)
                {
                    <MudButton Href="/login" Variant="Variant.Text" Class="back-login-btn" FullWidth="true">
                        ← Back to sign in
                    </MudButton>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private MudForm? form;
    private readonly ResetPasswordRequest request = new();
    private readonly ResetPasswordRequestValidator validator = new();
    private string? _resetToken;
    private bool _processing;
    private bool _completed;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private string _resultMessage = PasswordRecoveryMessages.ResetSuccess;

    private Task HandleRateLimitTick() => InvokeAsync(StateHasChanged);

    private void TogglePassword() => _showPassword = !_showPassword;
    private void ToggleConfirmPassword() => _showConfirmPassword = !_showConfirmPassword;

    protected override void OnParametersSet()
    {
        // Capture the one-time reset token before removing it from the address bar.
        _resetToken = Token?.Trim();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrWhiteSpace(_resetToken))
            return;

        try
        {
            await JS.InvokeVoidAsync("xqareNavigation.replaceUrl", "/reset-password");
        }
        catch
        {
            // The reset token remains usable for this component lifetime if browser
            // history interop is unavailable; the server still enforces single use.
        }
    }

    private async Task Submit()
    {
        if (_processing || form == null)
            return;

        _processing = true;
        try
        {
            request.Token = _resetToken ?? string.Empty;

            // The reset token is supplied through the query string, not a visible
            // MudTextField, so validate it explicitly before validating form fields.
            var resetValidation = await validator.ValidateAsync(request);
            var tokenError = resetValidation.Errors.FirstOrDefault(
                error => error.PropertyName == nameof(request.Token));
            if (tokenError is not null)
            {
                Snackbar.Add(tokenError.ErrorMessage, MudBlazor.Severity.Error);
                return;
            }

            await form.ValidateAsync();
            if (!form.IsValid)
                return;
            var result = await AuthService.ResetPasswordAsync(request);
            if (result.IsSuccess)
            {
                _resultMessage = result.Message;
                _completed = true;
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(CommonMessages.RequestFailed, Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

}
