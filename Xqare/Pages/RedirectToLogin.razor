@using Microsoft.AspNetCore.Components.Authorization
@using Xqare.BusinessLayer.DTO
@using Xqare.BusinessLayer.Interfaces.Auth
@inject NavigationManager Nav
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

@if (_checkingSession)
{
    <section class="session-restore-page">
        <MudPaper Class="session-restore-card" Elevation="0">
            <div class="session-restore-brand"><span>X</span>QARE</div>
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="session-restore-title">Restoring your session</MudText>
            <MudText Typo="Typo.body2" Class="session-restore-subtitle">
                Checking your secure connection...
            </MudText>
        </MudPaper>
    </section>
}
else if (_restoreUnavailable)
{
    <section class="session-restore-page">
        <MudPaper Class="session-restore-card session-restore-error" Elevation="0">
            <div class="session-restore-brand"><span>X</span>QARE</div>
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="session-restore-title">We couldn't verify your session</MudText>
            <MudText Typo="Typo.body2" Class="session-restore-subtitle">
                The authentication service did not respond. Your saved session has not been cleared.
                Check your connection and try again.
            </MudText>
            <MudStack Direction="Row" Spacing="2" Class="session-restore-actions" Justify="Justify.Center" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           Disabled="_checkingSession" OnClick="RetrySessionRestore"
                           Class="session-restore-primary">
                    Try again
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="NavigateToLogin">
                    Go to sign in
                </MudButton>
            </MudStack>
        </MudPaper>
    </section>
}

@code {
    private bool _checkingSession = true;
    private bool _restoreUnavailable;

    protected override Task OnInitializedAsync() => RestoreSessionAsync();

    private async Task RestoreSessionAsync()
    {
        _checkingSession = true;
        _restoreUnavailable = false;

        try
        {
            var outcome = await AuthService.InitializeAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity?.IsAuthenticated == true)
                return;

            if (outcome == SessionRestoreOutcome.Unavailable)
            {
                _restoreUnavailable = true;
                return;
            }

            NavigateToLogin();
        }
        catch
        {
            // A client/network failure is retryable and must not clear stored credentials.
            _restoreUnavailable = true;
        }
        finally
        {
            _checkingSession = false;
        }
    }

    private Task RetrySessionRestore() => RestoreSessionAsync();

    private void NavigateToLogin()
    {
        var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
        var destination = string.IsNullOrWhiteSpace(returnUrl)
            ? "/login"
            : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Nav.NavigateTo(destination, replace: true);
    }
}
