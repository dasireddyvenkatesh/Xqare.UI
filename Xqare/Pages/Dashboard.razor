@page "/dashboard"
@layout AuthenticatedLayout
@using Xqare.Wrappers.DashboardWrapper
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Dashboard | XQARE</PageTitle>
<section class="dashboard-page">
    <MudContainer MaxWidth="MaxWidth.Large" Class="dashboard-content">
        <WelcomeWrapper />
        <QuickActionsWrapper />
        <ProgressWrapper />
        <InsightsWrapper />
        <LaunchWrapper />
    </MudContainer>
</section>
