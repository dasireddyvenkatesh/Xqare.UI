@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@using Xqare.Pages
@using Xqare.BusinessLayer.Interfaces.Auth
@inject IAuthService AuthService
@inject LazyAssemblyLoader AssemblyLoader

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Pages.NotFound)"
        OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start session restoration only after the first UI render. This must
            // never hold the router or public pages behind the refresh-token request.
            _ = RestoreSessionSafelyAsync();
        }

        return Task.CompletedTask;
    }

    private async Task RestoreSessionSafelyAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
        }
        catch
        {
            // Keep the application shell available. Protected routes handle an
            // unsuccessful restore by sending the user to the login page.
        }
    }

    private readonly SemaphoreSlim _fluentValidationLoadLock = new(1, 1);
    private bool _fluentValidationLoaded;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        context.CancellationToken.ThrowIfCancellationRequested();

        var route = context.Path.Split('?', '#')[0].Trim('/');

        // These forms construct FluentValidation validators directly. Keep the
        // package out of the initial homepage/authentication download and load it
        // only when a route that needs validation is opened.
        var requiresValidation = route.Equals("login", StringComparison.OrdinalIgnoreCase)
            || route.Equals("register", StringComparison.OrdinalIgnoreCase)
            || route.Equals("contact", StringComparison.OrdinalIgnoreCase)
            || route.Equals("hiringpartner", StringComparison.OrdinalIgnoreCase);

        if (!requiresValidation || _fluentValidationLoaded)
            return;

        await _fluentValidationLoadLock.WaitAsync(context.CancellationToken);
        try
        {
            if (_fluentValidationLoaded)
                return;

            await AssemblyLoader.LoadAssembliesAsync(new[] { "FluentValidation.dll" });
            _fluentValidationLoaded = true;

            context.CancellationToken.ThrowIfCancellationRequested();
        }
        finally
        {
            _fluentValidationLoadLock.Release();
        }
    }
}
