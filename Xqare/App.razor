@using Microsoft.AspNetCore.Components.Authorization
@using Xqare.Pages
@using Xqare.BusinessLayer.Interfaces.Auth
@inject IAuthService AuthService

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Start session restoration only after the first UI render. This must
            // never hold the router or public pages behind the refresh-token request.
            _ = RestoreSessionSafelyAsync();
        }

        return Task.CompletedTask;
    }

    private async Task RestoreSessionSafelyAsync()
    {
        try
        {
            await AuthService.InitializeAsync();
        }
        catch
        {
            // Keep the application shell available. Protected routes handle an
            // unsuccessful restore by sending the user to the login page.
        }
    }

}
