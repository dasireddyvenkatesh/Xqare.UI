@using Microsoft.AspNetCore.Components.Authorization
@using Xqare.BusinessLayer.Interfaces.Auth
@inject IJSRuntime JS
@inject IAuthService AuthService

<section class="header-wrapper">
    <MudAppBar Fixed="true" Elevation="0" Class="@HeaderClass">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="header-container">

            <div class="logo">XQARE</div>

            <!-- DESKTOP NAV: switch links based on authentication state -->
            <div class="nav-desktop d-none d-lg-flex">
                <AuthorizeView>
                    <Authorized>
                        <div class="nav-links">
                            <MudLink Href="/">Home</MudLink>
                            <MudLink Href="/profile">Profile</MudLink>
                        </div>
                        <MudButton Class="signup-btn" OnClick="Logout">LOG OUT</MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <div class="nav-links">
                            <MudLink Href="/">Home</MudLink>
                            <MudLink Disabled="true" Href="/mentors">Mentors</MudLink>
                            <MudLink Disabled="true" Href="/community">Community</MudLink>
                            <MudLink Disabled="true" Href="/jobs">Jobs</MudLink>
                            <MudLink Href="/contact">Contact</MudLink>
                            <MudLink Href="/login">Login</MudLink>
                        </div>
                        <MudButton Href="/register" Class="signup-btn">SIGN UP</MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <!-- MOBILE NAV: visible below md only -->
            <div class="nav-mobile d-flex d-lg-none align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <MudLink Href="/profile" Class="mobile-login">Profile</MudLink>
                    </Authorized>
                    <NotAuthorized>
                        <MudLink Href="/login" Class="mobile-login">Login</MudLink>
                    </NotAuthorized>
                </AuthorizeView>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               OnClick="ToggleDrawer" />
            </div>

        </MudContainer>
    </MudAppBar>
</section>

<!-- BACKDROP: only in DOM when drawer is open -->
@if (_drawerOpen)
{
    <div class="drawer-backdrop d-lg-none" @onclick="CloseDrawer"></div>
}

<!-- DRAWER PANEL -->
<div class="custom-drawer d-lg-none @(_drawerOpen ? "drawer-open" : "")">
    <div class="drawer-header">
        <div class="logo drawer-logo">XQARE</div>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Color="Color.Inherit"
                       OnClick="CloseDrawer" />
    </div>

    <nav class="drawer-content">
        <AuthorizeView>
            <Authorized>
                <MudLink Href="/" OnClick="CloseDrawer">Home</MudLink>
                <MudLink Href="/profile" OnClick="CloseDrawer">Profile</MudLink>
                <MudButton Class="signup-btn drawer-signup" OnClick="LogoutAndClose">LOG OUT</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudLink Href="/" OnClick="CloseDrawer">Home</MudLink>
                <MudLink Disabled="true" Href="/mentors" OnClick="CloseDrawer">Mentors</MudLink>
                <MudLink Disabled="true" Href="/community" OnClick="CloseDrawer">Community</MudLink>
                <MudLink Disabled="true" Href="/jobs" OnClick="CloseDrawer">Jobs</MudLink>
                <MudLink Href="/contact" OnClick="CloseDrawer">Contact</MudLink>
                <MudLink Href="/login" OnClick="CloseDrawer">Login</MudLink>
                <MudButton Href="/register" Class="signup-btn drawer-signup" OnClick="CloseDrawer">SIGN UP</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string HeaderClass = "header";
    private bool _drawerOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("headerScrollHandler",
                DotNetObjectReference.Create(this));
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        await AuthService.Logout();
    }

    private async Task LogoutAndClose()
    {
        _drawerOpen = false;
        await AuthService.Logout();
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    [JSInvokable]
    public void OnScroll(bool isScrolled)
    {
        HeaderClass = isScrolled ? "header scrolled" : "header";
        StateHasChanged();
    }
}