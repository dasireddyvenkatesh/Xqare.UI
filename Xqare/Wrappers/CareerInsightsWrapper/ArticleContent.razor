@using Xqare.Models.Carrer_Insights_Detail
<main class="article-body">
    @foreach (var section in Sections)
    {
        <section id="@section.Id" data-section-id="@section.Id" class="article-section">
            <MudText Typo="Typo.h2" Class="article-section__title">@section.Title</MudText>

            @foreach (var block in section.Blocks)
            {
                <ArticleContentBlock Block="block" />
            }
        </section>
    }

    <ArticleShareFooter />
    <ArticleCallToAction Model="CallToAction" />
</main>

@code {
    [Parameter] public IReadOnlyList<CareerInsightSection> Sections { get; set; } = [];
    [Parameter] public CareerInsightCallToAction CallToAction { get; set; } = new();
}
