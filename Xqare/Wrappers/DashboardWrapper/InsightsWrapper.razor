@using MudBlazor
@using Xqare.Models.Carrer_Insights

<section class="insights-wrapper" aria-label="Career insights">
    <MudPaper Class="dashboard-panel insights-card" Elevation="0">
        <div class="panel-heading">
            <div>
                <MudText Typo="Typo.h6" Class="panel-title">Explore career insights</MudText>
                <MudText Typo="Typo.caption" Class="panel-subtitle">Practical guidance for your next career step.</MudText>
            </div>
            <MudButton Href="/career-insights" Variant="Variant.Text" Color="Color.Warning" Class="panel-link">
                View all
            </MudButton>
        </div>

        <div class="insights-list">
            @foreach (var article in Articles)
            {
                <MudButton Href="@($"/career-insights/{article.Id}")"
                           Variant="Variant.Text"
                           FullWidth="true"
                           Class="insight-item"
                           @key="article.Id">
                    <span class="insight-copy">
                        <MudText Typo="Typo.caption" Class="insight-meta">
                            @article.CategoryName · @article.ReadMinutes min read
                        </MudText>
                        <MudText Typo="Typo.body2" Class="insight-title">@article.Title</MudText>
                        <MudText Typo="Typo.caption" Class="insight-desc">@article.Summary</MudText>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="insight-arrow" />
                </MudButton>
            }
        </div>
    </MudPaper>
</section>

@code {
    private IReadOnlyList<CareerInsightArticle> Articles { get; } =
        CareerInsightSeed.Build().Articles
            .OrderByDescending(article => article.PublishedOn)
            .Take(3)
            .ToArray();
}
