@using MudBlazor

<section class="quick-actions" aria-label="Quick access">
    <div class="quick-actions-heading">
        <div>
            <MudText Typo="Typo.h6" Class="section-title">Quick access</MudText>
            <MudText Typo="Typo.caption" Class="section-subtitle">Go straight to the areas you use most.</MudText>
        </div>
    </div>

    <div class="actions-grid">
        <MudButton Href="/profile" Variant="Variant.Text" FullWidth="true" Class="action-card">
            <span class="action-icon-wrap">
                <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Class="action-icon" />
            </span>
            <span class="action-copy">
                <MudText Typo="Typo.body2" Class="action-title">My Profile</MudText>
                <MudText Typo="Typo.caption" Class="action-desc">Personal details and bio</MudText>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="action-arrow" />
        </MudButton>

        <MudButton Href="/career-insights" Variant="Variant.Text" FullWidth="true" Class="action-card">
            <span class="action-icon-wrap">
                <MudIcon Icon="@Icons.Material.Filled.LightbulbOutline" Class="action-icon" />
            </span>
            <span class="action-copy">
                <MudText Typo="Typo.body2" Class="action-title">Career Insights</MudText>
                <MudText Typo="Typo.caption" Class="action-desc">Advice and career guidance</MudText>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="action-arrow" />
        </MudButton>

        <MudButton Href="/settings" Variant="Variant.Text" FullWidth="true" Class="action-card">
            <span class="action-icon-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Security" Class="action-icon" />
            </span>
            <span class="action-copy">
                <MudText Typo="Typo.body2" Class="action-title">Settings &amp; Security</MudText>
                <MudText Typo="Typo.caption" Class="action-desc">Password, MFA and sessions</MudText>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="action-arrow" />
        </MudButton>
    </div>
</section>
