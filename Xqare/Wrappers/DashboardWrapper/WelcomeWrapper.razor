@using MudBlazor
@using Xqare.BusinessLayer.DTO

<section class="welcome-wrapper" aria-label="Welcome">
    <div class="welcome-card">
        <div class="welcome-copy">
            <MudText Typo="Typo.h5" Class="welcome-title">
                Welcome back@if (!string.IsNullOrWhiteSpace(GreetingName)){<span>, @GreetingName</span>} 👋
            </MudText>
            <MudText Typo="Typo.body2" Class="welcome-subtitle">
                Your career development workspace is ready.
            </MudText>
        </div>

        <div class="welcome-actions">
            <MudButton Href="/profile"
                       Variant="Variant.Filled"
                       Color="Color.Warning"
                       Class="welcome-primary">
                @(IsProfileComplete ? "View profile" : "Complete profile")
            </MudButton>
            <MudButton Href="/career-insights"
                       Variant="Variant.Outlined"
                       Color="Color.Inherit"
                       Class="welcome-secondary">
                Explore insights
            </MudButton>
        </div>
    </div>
</section>

@code {
    [Parameter] public MyProfileResponse? Profile { get; set; }

    private string GreetingName
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Profile?.FirstName))
                return Profile.FirstName.Trim();

            var displayName = Profile?.DisplayName?
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault();

            return displayName?.Trim() ?? string.Empty;
        }
    }

    private bool IsProfileComplete =>
        !string.IsNullOrWhiteSpace(Profile?.FirstName) &&
        !string.IsNullOrWhiteSpace(Profile?.LastName) &&
        !string.IsNullOrWhiteSpace(Profile?.PhoneNumber) &&
        !string.IsNullOrWhiteSpace(Profile?.Bio);
}
